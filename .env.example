# Copiá este archivo como .env.local y completá con los datos de tu proyecto
# de Supabase (Project Settings → API). .env.local no se versiona.
#
# La anon key es pública por diseño: viaja en el JavaScript de la página. Lo
# que protege los datos son las políticas de Row Level Security del esquema,
# no el secreto de esta clave. La `service_role` key, en cambio, NUNCA va acá
# ni en ningún archivo del front.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
